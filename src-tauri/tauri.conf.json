{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GEC Uplink",
  "version": "0.2.1",
  "identifier": "com.goblinengineering.uplink",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GEC Uplink",
        "width": 1000,
        "height": 720,
        "minWidth": 760,
        "minHeight": 540,
        "visible": false,
        "resizable": true
      },
      {
        "label": "tray",
        "title": "GEC Uplink",
        "width": 340,
        "height": 480,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; connect-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "GEC addon delivery + data sync",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5REU5MjhFMjA1NTNFRTMKUldUalBsVWdqcExlK1V1VGRZRXhnTEIrUmhMTmt1Z01Db2tVOUhVTFNYbXNsUXp5R0MyZS9acFIK"
    }
  }
}
